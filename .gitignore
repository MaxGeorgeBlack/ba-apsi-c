# Only the reproducible source tree belongs in the repository.
/*
!/.gitignore
!/.gitattributes
!/CMakeLists.txt
!/README.md
!/src/
!/include/
!/params/
!/tests/
!/scripts/
!/experiments/
!/data/

/src/*
!/src/*.c
!/src/*.h
/include/*
!/include/*.h
/params/*
!/params/*.param
/tests/*
!/tests/*.c
!/tests/test_experiment_metrics.py
!/tests/test_setup_lifecycle.py
/scripts/*
!/scripts/build.sh
/experiments/*
!/experiments/precompute_check.c
!/experiments/requirements-slm.txt
!/experiments/rq3_common.py
!/experiments/rq3_intersect_basic.c
!/experiments/rq3_settings.json
!/experiments/run_paper.py
!/experiments/run_rq3_origin.py
!/experiments/run_slm.py
!/experiments/run_slm_suite.py
!/experiments/slm_metrics.py
!/experiments/verify.py
/data/*
!/data/slm/
/data/slm/*
!/data/slm/memories.jsonl
!/data/slm/policies.json
!/data/slm/queries.jsonl

__pycache__/
*.py[cod]
*.o
*.a
*.so*
